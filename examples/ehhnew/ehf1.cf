# ehf1.cf   this command file generates a new output data file with
#           episodes splitted according to marriage date.

nvar(

    dfile = rrdat.1,     # data file

    ID     [3.0] = c1,    # identification number
    NOJ    [2.0] = c2,    # spell number
    TStart [3.0] = c3,    # starting time
    TFin   [3.0] = c4,    # ending time
    SEX    [2.0] = c5,    # sex (1 men, 2 women)
    TI     [3.0] = c6,    # interview date
    TB     [3.0] = c7,    # birth date
    TE     [3.0] = c8,    # entry into labor market
    TMAR   [3.0] = c9,    # marriage date (0 if no marriage)
    PRES   [3.0] = c10,   # prestige of current job
    PRESN  [3.0] = c11,   # prestige of next job
    EDU    [2.0] = c12,   # highest educational attainment

    # additional variables

    DES [1.0] = if eq(TFin,TI) then 0 else 1,                    
    TSP [3.0] = 0,
    TFP [3.0] = TFin - TStart + 1,

    COHO2[1.0] =   ge(TB,468) & le(TB,504),  # cohort 2
    COHO3[1.0] =   ge(TB,588) & le(TB,624),  # cohort 3
    LFX[3.0]   =   TStart - TE,              # labor force experience
    PNOJ[2.0]  =   NOJ - 1,                  # previous number of jobs

    # define variable for episode splitting 

    MarrDate[3.0] = if le(TMAR,0) then 10000 else TMAR - TStart,
);

edef(           # define single episode data

    ts = TSP,   # starting time
    tf = TFP,   # ending time
    org = 0,    # origin state
    des = DES,  # destination state

    split = MarrDate,
);

epdat(
    keep = TSP,TFP,EDU,COHO2,COHO3,LFX,PNOJ,PRES,MarrDate,SEX,

    dtda = d.s1,    # request TDA description of output file rrdat.s1

) = rrdat.s1;       # output file
