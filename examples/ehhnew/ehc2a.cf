# ehc2a.cf   command file to plot a density function

nvar(
    dfile = ehc1.ltb,       # data file
    Case = case,
    Time = c1,              # time axis (begin of interval)
    Dens = c5,              # density              
);
tsel = Case[16,,30];        select second part of table

psfile = ehc2a.ps;          PostScript output file
psetup(
    pxlen =  80,    # length of x axis in mm
    pylen =  40,    # length of y axis in mm

    pxa   =  0,300,    # user coordinates on x axis
    pya   =  0,0.02,   # user coordinates on y axis
);
plxa (sc=60,ic=5);       plot x axis
plya (sc=0.01,ic=10);    plot y axis
plframe;                 plot frame

#plabel  = "Life Table Density Function";
#pxlabel = "Time in Months";
#pylabel = "Survivor Function";

plot = Time,Dens;       
pltext(xy=80,0.017) = "Life Table Density Function";


