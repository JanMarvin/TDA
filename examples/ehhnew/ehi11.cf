# ehi11.cf  command file to plot cumulative transition rates 

nvar(
    dfile = ehi10.bl,           # data file 
 
    TAB1 = c1[0],
    TAB2 = c1[1],
    Time = c2,
    CRate = c7,

); 
psfile = ehi11.ps;  output file
psetup(
    pxlen =  80,    # length of x axis in mm
    pylen =  40,    # length of y axis in mm

    pxa   = 0,300,  # user coordinates on x axis
    pya   = 0,5,    # user coordinates on y axis
);
plxa (sc=60,ic=5);     plot x axis
plya (sc=1,ic= 0);     plot y axis
#plframe;               plot frame

plot (sel=TAB1,lt=1) = Time,CRate;
plot (sel=TAB2,lt=5) = Time,CRate;
pltext(xy=240,2.3) = COHO1; 
pltext(xy=240,4.2) = COHO3;

