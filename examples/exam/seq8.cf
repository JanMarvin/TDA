# seq8.cf

nvar(
    dfile = seq.d4,
    ID     = c1,
    Y{0,5,2} = c2,
    S{0,5,8} = c8,
    V1     = c14,
    V2     = c15,
);
seqdef(sn=1) = Y0,,Y5;
seqdef(sn=2) = S0,,S5;
seq;                   info about current sequence data
seqev;                 count events in first sequence data structure
seqevd(dtda=t) = d;
