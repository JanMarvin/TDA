# ple6.cf  

nvar(
    dfile = rrdat.3,      # data file  

    TF      = c1,         # ending time = duration
    Status  = c2,         # destination state (= status)
    Group1  = c3[1],      # first group
    Group2  = c3[2],      # second group
);
edef(
    ts = 0,               # starting time = 0
    tf = TF,              # ending time = duration
    org = 0,              # origin state = 0
    des = Status,         # destination state (= status)
);
ple (
    grp = Group1,Group2,  # define two groups, men and women
    csf,                  # compare survivor functions
);

