# plot10.cf    example to show marker symbols

psfile = plot10.ps;  output file
psetup(
    pxlen = 100,
    pylen =  60,
    pxa  = -2,2,
    pya  =  0,1,
);
plframe;

#plabel = "Available Marker Symbols";

