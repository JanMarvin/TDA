# qrp3.cf

nvar(
  dfile = qrp1.dat,
  noc = 500,
  Y1 <4>[0.0] = c1,
  Y2 <4>[0.0] = c2,
  Y3 <4>[0.0] = c3,
  Y4 <4>[0.0] = c4,
  Y5 <4>[0.0] = c5,
  X1 <4>[9.6] = c6,
  X2 <4>[9.6] = c7,
  X3 <4>[9.6] = c8,
  X4 <4>[9.6] = c9,
  X5 <4>[9.6] = c10,
);
qresp(
    m = 8,                  # model selection             
    nw = 5,                 # number of waves
    nhp = 12,               # Hermite integration points
) = Y1,Y2,Y3,Y4,Y5,
    X1,X2,X3,X4,X5;

