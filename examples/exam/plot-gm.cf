# plot-gm.cf   plot Gompertz transition rates

psfile = plot-gm.ps;   output file
psetup(
    pxlen =  90,    # length of x axis in mm
    pylen =  50,    # length of y axis in mm

    pxa   =  0,5,   # user coordinates on x axis
    pya   =  0,3,   # user coordinates on y axis
);

plxa (sc=1);                
plya (sc=1);                 
plframe;

plotf (rx= 0(1)5,lt=1) = 1 + 0 * x;
plotf (rx= 0(0.1)5,lt=5) = exp(0.2 * x);
plotf (rx= 0(0.1)5,lt=6) = exp(-0.5 * x);

pltext (xy=4.3,1.1)  = "c = 0.0";
pltext (xy=4.3,2.1)  = "c = 0.2";
pltext (xy=4.3,0.2)  = "c = -0.5";



