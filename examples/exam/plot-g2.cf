# plot-g2.cf   Gen. gamma transition rates

psfile = plot-g2.ps;   output file
psetup(
    pxlen =  90,    # length of x axis in mm
    pylen =  50,    # length of y axis in mm

    pxa   =  0,5,   # user coordinates on x axis
    pya   =  0,3,   # user coordinates on y axis
);

plxa (sc=1);                
plya (sc=1);                 
plframe;

plotf (rx=0.01(0.02)5,lt=1) = 1^(1-0.5) * 
               exp(sqrt(1) * log(x) - 1 * exp(log(x)/sqrt(1))) /
               (x *  exp(lgam(1)) * (1 - icg(1 * exp(log(x)/sqrt(1)),1)));
plotf (rx=0.01(0.02)5,lt=5) = 1^(1-0.5) * 
               exp(sqrt(1) * log(x)/0.7 - 1 * exp((log(x)/0.7)/sqrt(1))) /
               (x *  exp(lgam(1)) * (1 - icg(1 * exp((log(x)/0.7)/sqrt(1)),1)));
plotf (rx=0.01(0.02)5,lt=6) = 1^(1-0.5) * 
               exp(sqrt(1) * log(x)/2 - 1 * exp((log(x)/2)/sqrt(1))) /
               (x *  exp(lgam(1)) * (1 - icg(1 * exp((log(x)/2)/sqrt(1)),1)));

pltext (xy=0.5,2.6 ) = "a = 0.0";
pltext (xy=0.5,2.35) = "k = 1.0";
pltext (xy=4,0.6)    = "b = 2.0";
pltext (xy=4,1.1)    = "b = 1.0";
pltext (xy=4,2)      = "b = 0.7";


