# glm1a.cf   gen. linear model

nvar(
    dfile = lsreg1.dat,     # data file
    Height = c1,
    Weight = c2,
);

glm(    # use default normal distribution

    v = Weight,Height,      # variables

    pcov = cov,             # write covariance matrix to cov
    ppar = par,             # write parameter to par
    pres = res,             # write residuals to res
    ab   = -1.e6,1.e6,      # domain of link function

) = mue;                    # user-defined link function (identity)
