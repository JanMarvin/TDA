# plot-ig.cf   inverse Gaussian transition rates

psfile = plot-ig.ps;   output file
psetup(
    pxlen =  90,    # length of x axis in mm
    pylen =  50,    # length of y axis in mm

    pxa   =  0,6,   # user coordinates on x axis
    pya   =  0,2.5, # user coordinates on y axis
);

plxa (sc=1);                
plya (sc=0.5);                 
plframe;

plotf (rx= 0.02(0.02)6,lt=1) =
    (ndf((1 * x - 1)/sqrt(x)) / x^(3/2)) /
    (nd((1 - 1 * x) / sqrt(x)) - exp(2 * 1) * nd((-1 - 1 * x) / sqrt(x)));
plotf (rx= 0.02(0.02)6,lt=5) =
    (ndf((0.1 * x - 1)/sqrt(x)) / x^(3/2)) /
    (nd((1 - 0.1 * x) / sqrt(x)) - exp(2 * 0.1) * nd((-1 - 0.1 * x) / sqrt(x)));
plotf (rx= 0.02(0.02)6,lt=6) =
    (ndf((1.5 * x - 1)/sqrt(x)) / x^(3/2)) /
    (nd((1 - 1.5 * x) / sqrt(x)) - exp(2 * 1.5) * nd((-1 - 1.5 * x) / sqrt(x)));

pltext (xy=5,0.21) = "a = 0.1";
pltext (xy=5,0.83) = "a = 1.0";
pltext (xy=5,1.46) = "a = 1.5";
pltext (xy=5,2.08) = "b = 1.0";


