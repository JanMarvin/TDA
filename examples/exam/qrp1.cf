# qrp1.cf   creates random data file qrp1.dat
#           for five panel waves

nvar(
    noc = 500,          # number of cases
    BETA = 1,

    # wave 1
    X1[9.6] = 0.1 + rd(-0.5,0.5),
    XI0 = rdn,
    EPS1 = sqrt(1 - 0.1 * 0.1) * rdn + 0.1 * XI0,

    # wave 2
    X2[9.6] = 0.2 + 0.5 * X1 + rd(-0.5,0.5),
    EPS2 = sqrt(1 - 0.2 * 0.2) * rdn + 0.2 * XI0,

    # wave 3
    X3[9.6] = 0.3 + 0.5 * X2 + rd(-0.5,0.5),
    EPS3 = sqrt(1 - 0.4 * 0.4) * rdn + 0.4 * XI0,

    # wave 4
    X4[9.6] = 0.4 + 0.5 * X3 + rd(-0.5,0.5),
    EPS4 = sqrt(1 - 0.6 * 0.6) * rdn + 0.6 * XI0,

    # wave 5
    X5[9.6] = 0.5 + 0.5 * X4 + rd(-0.5,0.5),
    EPS5 = sqrt(1 - 0.8 * 0.8) * rdn + 0.8 * XI0,

    SLambda = X1 - X2 + X3 - X4 + 2 * X5, 

    Y1 = ge(-1 + X1 * BETA + SLambda + EPS1,0),
    Y2 = ge(-1 + X2 * BETA + SLambda + EPS2,0),
    Y3 = ge(-1 + X3 * BETA + SLambda + EPS3,0),
    Y4 = ge(-1 + X4 * BETA + SLambda + EPS4,0),
    Y5 = ge(-1 + X5 * BETA + SLambda + EPS5,0),
);

pdata(  
    keep = Y1,Y2,Y3,Y4,Y5,X1,X2,X3,X4,X5,
    dtda = qrp1.tda,
) = qrp1.dat;







                                

