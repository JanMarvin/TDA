# plot15.cf  

psfile = plot15.ps;  output file
psetup(
    pxlen =  90, 
    pylen =  50, 
    pxa   = 0,10,
    pya   =  0,2,
);
plxa (sc=1);    plot x axis
plya (sc=1);    plot y axis
plframe;        plot frame

ploto (xy=2,1,gs=0.9) = 1;
plote (xy=7,1,gs=0.9) = 2,0.5;
plotp (lt=5) = 0,0.5,7,0.5;
plotp (lt=5) = 0,1.5,7,1.5;
plotp (lt=5) = 1,0,1,1;
plotp (lt=5) = 3,0,3,1;
plotp (lt=5) = 5,0,5,1;
plotp (lt=5) = 9,0,9,1;
pltext(xy=1.1,1.7) = "ploto (xy=2,1,gs=0.9) = 1;";
pltext(xy=5.1,1.7) = "plote (xy=7,1,gs=0.9) = 2,0.5;";
plotp (a=1,1) = 2,1,3,1;
plotp (a=1,1) = 7,1,9,1;
plotp (a=1,1) = 7,1,7,1.5;
pltext(xy=2.3,0.85) = 1;
pltext(xy=7.8,0.85) = 2;
pltext(xy=7.2,1.2) = 0.5;






