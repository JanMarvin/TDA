# plot-g1.cf   Gen. gamma transition rates

psfile = plot-g1.ps;   output file
psetup(
    pxlen =  90,    # length of x axis in mm
    pylen =  50,    # length of y axis in mm

    pxa   =  0,5,   # user coordinates on x axis
    pya   =  0,2,   # user coordinates on y axis
);

plxa (sc=1);                
plya (sc=1);                 
plframe;

plotf (rx= 0.01(0.02)5,lt=1) = 1^(1-0.5) * 
               exp(sqrt(1) * log(x) - 1 * exp(log(x)/sqrt(1))) /
               (x *  exp(lgam(1)) * (1 - icg(1 * exp(log(x)/sqrt(1)),1)));
plotf (rx=0.01(0.02)5,lt=5) = 0.5^(0.5-0.5) * 
               exp(sqrt(0.5) * log(x) - 0.5 * exp(log(x)/sqrt(0.5))) /
               (x *  exp(lgam(0.5)) * (1 - icg(0.5 * exp(log(x)/sqrt(0.5)),0.5)));
plotf (rx=0.01(0.02)5,lt=6) = 10^(10-0.5) * 
               exp(sqrt(10) * log(x) - 10 * exp(log(x)/sqrt(10))) /
               (x *  exp(lgam(10)) * (1 - icg(10 * exp(log(x)/sqrt(10)),10)));

pltext (xy=0.5,1.73) = "a = 0.0" ;
pltext (xy=0.5,1.57) = "b = 1.0" ;
pltext (xy=4,0.63)   = "k = 10.0";
pltext (xy=4,1.07)   = "k = 1.0" ;
pltext (xy=4,1.5)    = "k = 0.5" ;


