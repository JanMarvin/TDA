# plot9.cf    example to show line types

psfile = plot9.ps;  output file
psetup(
    pxlen = 100, 
    pylen =  60, 
    pxa = -2,2,  
    pya =  0,1,  
);
plframe;

#plabel = "Available Line Types";

plotp (lt=1) = -1.5,0.1,0.5,0.1;
plotp (lt=2) = -1.5,0.2,0.5,0.2;
plotp (lt=3) = -1.5,0.3,0.5,0.3;
plotp (lt=4) = -1.5,0.4,0.5,0.4;
plotp (lt=5) = -1.5,0.5,0.5,0.5;
plotp (lt=6) = -1.5,0.6,0.5,0.6;
plotp (lt=7) = -1.5,0.7,0.5,0.7;
plotp (lt=8) = -1.5,0.8,0.5,0.8;
plotp (lt=9) = -1.5,0.9,0.5,0.9;

pltext (xy=0.75,0.1) = "line type 1";
pltext (xy=0.75,0.2) = "line type 2";
pltext (xy=0.75,0.3) = "line type 3";
pltext (xy=0.75,0.4) = "line type 4";
pltext (xy=0.75,0.5) = "line type 5";
pltext (xy=0.75,0.6) = "line type 6";
pltext (xy=0.75,0.7) = "line type 7";
pltext (xy=0.75,0.8) = "line type 8";
pltext (xy=0.75,0.9) = "line type 9";








