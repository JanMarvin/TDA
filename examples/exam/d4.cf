nvar(                       # creating a new data matrix
    dfile = d1.dat,
    X1 = c1,
    X2 = c2,
    X3 = c3,
    X4 = c4,
    fmt = 4.1,
);
nvar(                      # adding variables
    dfile = d1.dat,
    Y1 = c1,
    Y2 = c2,
    Y3 = c3,
    Y4 = c4,
    match = Y3,X1,         # match Y3 with X1
    fmt = 5.2,
);
pdata = d4;
