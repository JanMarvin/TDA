# plot-sic.cf   plot Sickle transition rates

psfile = plot-sic.ps;   output file
psetup(
    pxlen =  90,    # length of x axis in mm
    pylen =  50,    # length of y axis in mm

    pxa   =  0,12,  # user coordinates on x axis
    pya   =  0,0.8, # user coordinates on y axis
);

plxa (sc=1,ic=2);                
plya (sc=0.4,ic=4);                 
plframe;

plotf (rx= 0(0.1)12,lt=1) = 1 * x * exp(-x / 1.0);
plotf (rx= 0(0.1)12,lt=5) = 1 * x * exp(-x / 0.5);
plotf (rx= 0(0.1)12,lt=6) = 1 * x * exp(-x / 2.0);

pltext (xy=4,0.11)  = "b = 1.0";
pltext (xy=2,0.06)  = "b = 0.5";
pltext (xy=10,0.14) = "b = 2.0";










  
