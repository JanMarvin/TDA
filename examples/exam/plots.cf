# plots.cf     illustration of font selection

psfile = plots.ps;  output file
psetup(
    pxlen = 120, 
    pylen = 60,  
    pxa = 0,10,  
    pya = 0,5 ,  
);
plxa (sc=1);
plya (sc=1,ic=2);
plframe;

pltext(xy=1,4) = "@141 = 2.5 \245 @142";
pltext(xy=4,4) = "pltext (xy=1,4) = \324\100141 = 2.5 \\245 \100142\324";
pltext(xy=1,2) = "@123 = @173 @161 @174 @161 @316 @121 @175";
pltext(xy=2.2,0.9) = "pltext (xy=1,2) = \324\100123 = \100173 \100161 \100174 \100161 \100316 \100121 \100175\324";
pltext(xy=1,3) = "Sm\277rebr\277d";
pltext(xy=4,3) = "pltext (xy=1,3) = \324Sm\\277rebr\\277d\324";
plotp (a=1,1) = 3.5,4.05,2.7,4.05;
plotp (a=1,1) = 3.5,3.05,2.7,3.05;
plotk (sc=-90) = 1.5,1.5,3.2,1.5,3.2,2.1;
plotp (a=1,1) = 3.2,2.1,2.9,2.1;
plotk (sc=-90) = 1.5,1.5,1.5,0.95; 
plotp = 1.5,0.95,2,0.95;





