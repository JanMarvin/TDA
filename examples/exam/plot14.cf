# plot14.cf  

psfile = plot14.ps;  output file
psetup(
    pxlen =  90, 
    pylen =  50, 
    pxa   = 0,10,
    pya   =  0,6,
);
plxa (sc=1);    plot x axis
plya (sc=1);    plot y axis
plframe;        plot frame

plotp  (lt=5) = 1,2,4,5;
plotk  (a=1,1,sc=45) = 1,2,4,5;
plotp  (lt=5) = 1,2,1,4;
ploto  (xy=1,2) = 10,45,90;
pltext (xy=0.5,1) = "plotk(a=1,1,sc=45) = a,b,c,d;";
pltext (xy=0.7,1.6) = "(a,b)";
pltext (xy=4.2,5.1) = "(c,d)";
ploto  (xy=1,2,lt=2) = 0.8,45,90;
pltext (xy=1.15,2.4) = @141;

plotk  (sc=45) = 6,2,6,4,7,5;
plotk  (sc=-45) = 9,2,9,4,8,5;

pltext (xy=5.5,1.3) = "plotk(sc=45) = 6,2,6,4,7,5;";
pltext (xy=5.5,0.8) = "plotk(sc=-45) = 9,2,9,4,8,5;";
plotp  (a=1,1) = 5.3,1.4,5.3,2.2,5.7,2.5;
plotp  (a=1,1) = 9.6,1.2,9.6,2.2,9.2,2.5;




