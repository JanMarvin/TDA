/yorg 100 def
xorg yorg translate
/rf  0.00 def rf rotate
/sfx  1.00 def
/sfy  1.00 def
sfx sfy scale

%#Parameter: 100 100 100 170.13 -0.293893 -0.5 0.293893 0.5 0 0 1 1 0
1 setlinecap
1 setlinejoin


%#1: plgeosd
gsave
[] 0 setdash
0.5670 setlinewidth
grestore
showpage
