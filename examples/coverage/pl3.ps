/m  {moveto} bind def
/rm {rmoveto} bind def
/l  {lineto} bind def
/rl {rlineto} bind def

/fsiz 0 def % font size
/FT {/TFont findfont fsiz scalefont setfont} bind def
/FS {/Symbol findfont fsiz scalefont setfont} bind def

/ssiz 1 def % half size of symbol
/lpt  0 def % size of numerical labels
/str 20 string def
/xmin 0 def

/sclear { % clear area for string
gsave currentpoint pop -2 add fsiz 4 div m
dup stringwidth exch 4 add exch rl
0 setlinecap fsiz 2 add setlinewidth
1 setgray stroke grestore
} def
/center { % center a string
    dup stringwidth pop
    2 div neg 0 rm
} def
/aright { % right justified
    dup stringwidth pop
    neg 0 rm
} def
/adjust { % adjust for y axis labels
    dup stringwidth pop
    neg lpt 3 div neg rm
    currentpoint pop xmin lt {currentpoint pop /xmin exch def} if
} def
/invers {
    1 setgray fill 0 setgray
} def
/circle {
    newpath ssiz 0 360 arc
} def
/cross {
    gsave
    ssiz neg 0 rm ssiz 2 mul 0 rl
    ssiz neg ssiz rm 0 ssiz 2 mul neg rl
    stroke
    grestore
} def
/xsym {
    gsave
    45 rotate    ssiz neg 0 rm ssiz 2 mul 0 rl
    ssiz neg ssiz rm 0 ssiz 2 mul neg rl
    stroke
    grestore
} def
/square {
    gsave
    ssiz neg ssiz neg rm ssiz 2 mul 0 rl
    0 ssiz 2 mul rl ssiz 2 mul neg 0 rl closepath
    gsave 1 setgray fill 0 setgray grestore
} def
/trian1 {
    gsave
    ssiz neg ssiz neg rm ssiz 2 mul 0 rl
    ssiz neg ssiz 2 mul rl closepath
    gsave 1 setgray fill 0 setgray grestore
} def
/trian2 {
    gsave
    ssiz neg ssiz rm ssiz ssiz 2 mul neg rl
    ssiz ssiz 2 mul rl closepath
    gsave 1 setgray fill 0 setgray grestore
} def
/rhomb {
    gsave
    ssiz neg 0 rm ssiz ssiz neg rl
    ssiz ssiz rl ssiz neg ssiz rl closepath
    gsave 1 setgray fill 0 setgray grestore
} def
end         % pop TDAdict off the dictionary stack
%%EndProlog
