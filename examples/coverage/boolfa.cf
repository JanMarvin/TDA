# boolfa.cf -- Boolean function analysis, all minimisation algorithms
nvar(
    dfile = bool.dat,
    Y  [2.0] = c1,
    X1 [2.0] = c2,
    X2 [2.0] = c3,
    X3 [2.0] = c4,
    X4 [2.0] = c5,
    X5 [2.0] = c6,
);
bfa(alg=1, ptab=1, ptab1=1) = Y,X1,X2,X3,X4,X5;
bfa(alg=2, ptab1=1) = Y,X1,X2,X3,X4,X5;
bfa(alg=3, ptab1=1) = Y,X1,X2,X3,X4,X5;
bfa(opt=2, alg=3) = Y,X1,X2,X3,X4,X5;
bfa(opt=3, alg=2) = Y,X1,X2,X3,X4,X5;

# alg=0 is bfa's documented default (skip the minimization step).  The
# shared option parser used to reject 0 and echo the raw command text
# as the error; it accepts 0 now.
bfa(alg=0, ptab1=1) = Y,X1,X2,X3,X4,X5;
