# exprops.cf -- exercise the expression evaluator's operator set
nvar(
    dfile = ex.dat,
    ID [2.0] = c1,
    X  [6.2] = c2,
    G  [2.0] = c3,
    A1 [8.4] = X + 1,
    A2 [8.4] = X - 1,
    A3 [8.4] = X * 2,
    A4 [8.4] = X / 2,
    A5 [8.4] = X ^ 2,
    A6 [8.4] = abs(X - 3),
    A7 [8.4] = exp(X / 10),
    A8 [8.4] = log(X + 1),
    A9 [8.4] = sqrt(X),
    B1 [8.4] = sin(X),
    B2 [8.4] = cos(X),
    B3 [8.4] = floor(X),
    B4 [8.4] = ceil(X),
    B5 [8.4] = sign(X - 3),
    B6 [8.4] = rnd(X),
    B7 [8.4] = lgam(X + 1),
    B8 [8.4] = digam(X + 1),
    C1 [8.4] = eq(G,1),
    C2 [8.4] = ne(G,1),
    C3 [8.4] = lt(X,3),
    C4 [8.4] = le(X,3),
    C5 [8.4] = gt(X,3),
    C6 [8.4] = ge(X,3),
    C7 [8.4] = and(gt(X,2), lt(X,5)),
    C8 [8.4] = or(lt(X,2), gt(X,5)),
    D1 [8.4] = mean(X),
    D2 [8.4] = gmean(X,G),
    D3 [8.4] = gsum(X,G),
    D4 [8.4] = gmin(X,G),
    D5 [8.4] = gmax(X,G),
    D6 [8.4] = gstd(X,G),
    D8 [8.4] = rank(X),
    E1 [8.4] = lag(X,1),
    E2 [8.4] = mav(X,2),
    E3 [8.4] = cum(X),
    E4 [8.4] = pi,
);
pdata() = out.txt;
