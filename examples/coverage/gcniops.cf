# gcniops.cf -- t_gg.c coverage: gcni ("Comparing Neighborhoods"),
# undocumented in tda.hlp (found via its own source header comment
# in t_gg.c) and never tested anywhere in the existing corpus
# (confirmed by grep before writing this). Requires an undirected,
# unvalued graph (gdd gt=1).
#
# Graph: edges 1-2, 2-3, 1-3 (a triangle among 1,2,3) plus 3-4 (a
# pendant edge). opt=1 compares each node's CLOSED neighborhood
# (itself + its direct neighbors, confirmed from output -- not the
# open neighborhood the manual's wording might suggest) by size:
#   node 1: closed nbhd {1,2,3}, size 3, 3 internal edges (a triangle)
#   node 2: closed nbhd {1,2,3}, size 3, 3 internal edges
#   node 3: closed nbhd {1,2,3,4}, size 4, 4 internal edges
#   node 4: closed nbhd {3,4}, size 2, 1 internal edge
# -> 3 classes: {1,2} (size 3), {3} (size 4), {4} (size 2). Every
# size and edge count checked by hand against the graph above.
#
# The manual (tda.hlp) documents the secondary output as "df=...,
# list of neighborhoods" -- the real keyword, found in t_parm.c, is
# "prot=". Another stale-doc instance, recorded in README.md.

silent = -1;

nvar(dfile=edges.dat, I=c1, J=c2, V=c3);
gdd(gt=1) = I,J,V;
gcni(opt=1, prn=2, n=1, prot=neigh.txt) = out.txt;
