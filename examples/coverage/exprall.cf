# exprall.cf -- every operator in t_eval.c's OPS[] table that evaluates
# on a plain numeric frame, called with the argument count the table
# gives (the fourth field), not the count its opcode comment implies.
# Generated by testing each operator on its own; 109 of 146 candidates
# evaluate here, the rest need a context this frame does not provide
# (sequences, spatial data, matrices, string variables).
nvar(
    dfile = ex.dat,
    ID [2.0] = c1,
    X  [6.2] = c2,
    G  [2.0] = c3,
    W000 [10.4] = exp(X),
    W001 [10.4] = log(X),
    W002 [10.4] = rnd(X),
    W003 [10.4] = abs(X),
    W004 [10.4] = sign(X),
    W005 [10.4] = floor(X),
    W006 [10.4] = ceil(X),
    W010 [10.4] = sqrt(X),
    W011 [10.4] = sin(X),
    W012 [10.4] = cos(X),
    W013 [10.4] = lgam(X),
    W014 [10.4] = icg1(X,G),
    W016 [10.4] = eexp(X),
    W017 [10.4] = digam(X),
    W018 [10.4] = trigam(X),
    W020 [10.4] = icg(X,G),
    W024 [10.4] = poisson(X,G),
    W025 [10.4] = negbin(X,G,ID),
    W026 [10.4] = gclen(X,G,ID,X),
    W030 [10.4] = not(X),
    W031 [10.4] = and(X,G),
    W032 [10.4] = or(X,G),
    W033 [10.4] = eq(X,G),
    W034 [10.4] = ne(X,G),
    W035 [10.4] = lt(X,G),
    W036 [10.4] = le(X,G),
    W037 [10.4] = gt(X,G),
    W038 [10.4] = ge(X,G),
    W039 [10.4] = if(X,G,ID),
    W040 [10.4] = ndf(X),
    W042 [10.4] = nd(X),
    W043 [10.4] = mr(X),
    W044 [10.4] = td(X,G),
    W045 [10.4] = chd(X,G),
    W046 [10.4] = fd(X,G,ID),
    W047 [10.4] = jul(X,G,ID),
    W048 [10.4] = jul1(X,G,ID),
    W049 [10.4] = rd(X,G),
    W051 [10.4] = grd(X),
    W052 [10.4] = july(X),
    W053 [10.4] = julm(X),
    W054 [10.4] = juld(X),
    W055 [10.4] = num(X,G),
    W058 [10.4] = row(X),
    W059 [10.4] = col(X),
    W061 [10.4] = rdp1(X),
    W069 [10.4] = lag(X,G),
    W070 [10.4] = sum(X),
    W071 [10.4] = mean(X),
    W072 [10.4] = std(X),
    W073 [10.4] = cum(X),
    W074 [10.4] = cd(X),
    W075 [10.4] = cdv(X),
    W076 [10.4] = vmin(X),
    W077 [10.4] = vmax(X),
    W078 [10.4] = suc(X),
    W079 [10.4] = pre(X),
    W080 [10.4] = mav(X,G),
    W081 [10.4] = vdif(X,G),
    W082 [10.4] = cmean(X,G),
    W083 [10.4] = cmean1(X,G),
    W084 [10.4] = sort(X),
    W085 [10.4] = snum(X),
    W086 [10.4] = rank(X),
    W087 [10.4] = ndv(X),
    W088 [10.4] = ndv1(X,G),
    W089 [10.4] = ndv2(X,G,ID),
    W093 [10.4] = cnteq(X,G),
    W094 [10.4] = cntne(X,G),
    W095 [10.4] = cntlt(X,G),
    W096 [10.4] = cntgt(X,G),
    W097 [10.4] = cntle(X,G),
    W098 [10.4] = cntge(X,G),
    W099 [10.4] = gcnt(X),
    W100 [10.4] = grec(X),
    W101 [10.4] = gsn(X),
    W102 [10.4] = gfirst(X),
    W103 [10.4] = glast(X),
    W104 [10.4] = gsum(X,G),
    W105 [10.4] = gmean(X,G),
    W106 [10.4] = gstd(X,G),
    W107 [10.4] = gmin(X,G),
    W108 [10.4] = gmax(X,G),
    W109 [10.4] = gsort(X,G),
    W110 [10.4] = gndv(X,G),
    W111 [10.4] = gndv1(X,G,ID),
    W112 [10.4] = change(X),
    W113 [10.4] = cntch(X),
    W114 [10.4] = ccntch(X),
    W115 [10.4] = lagch(X),
    W118 [10.4] = bmin(X),
    W119 [10.4] = bmax(X),
    W120 [10.4] = bfa(X),
    W121 [10.4] = bfr(X),
    W122 [10.4] = bnrec,
    W123 [10.4] = brec,
    W124 [10.4] = bfirst,
    W125 [10.4] = blast,
    W126 [10.4] = bnum,
    W127 [10.4] = brd,
    W128 [10.4] = case,
    W129 [10.4] = nvar,
    W130 [10.4] = pi,
    W131 [10.4] = rdn1,
    W132 [10.4] = rdn,
    W133 [10.4] = rd,
    W134 [10.4] = nocdm,
    W135 [10.4] = noc,
    W136 [10.4] = bnoc,
);
pdata() = out.txt;
