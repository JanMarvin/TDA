# matc5.cf -- t_matc.c coverage batch 5: mls/mlse/mlsi/mlsei/mnls (the
# m_mls family, opt=0..4 -- distinct from the already-covered
# m_mlsei1). S = [X | y]. mls/mlse both reduce to plain OLS (checked
# against numpy.linalg.lstsq); mlsi treats every row as an inequality
# constraint rather than an objective term (opt=2 passes mi=row, ma=0
# to lsei -- confirmed by reading the exact lsei() call arguments,
# not assumed from the name), so it is checked structurally
# (constraint satisfied, no error) rather than against a fitted
# value; mlsei is exercised with real equality AND inequality rows
# this time (unlike mlsei1.cf's me=mi=0 case); mnls (nonnegative
# least squares) is checked for the defining property of NNLS: every
# fitted coefficient >= 0.

mdef(S,3,3) =   1, 1, 3,
                2, 0, 2,
                3, 1, 6;
mls(S,R0);
mpr(R0);

mlse(S,R1);
mpr(R1);

mlsi(S,R2);
mpr(R2);

# mlsei(S,me,mi,R): 1 equality row (row1: x1+x2=3 exactly), 1
# inequality row (row2), 1 objective row (row3).
mlsei(S,1,1,R3);
mpr(R3);

# mnls(S,me,l,R): nonnegative least squares, no equality rows.
mnls(S,0,0,R4);
mpr(R4);
