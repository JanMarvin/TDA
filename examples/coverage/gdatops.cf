# gdatops.cf -- t_gdat.c coverage: nvar's less-common options.
# vsel= (case selection while creating variables, "cannot be used in
# block mode" per its own manual entry) and break= (stop reading once
# a condition becomes true, the triggering row itself excluded) both
# use this system's function-style comparison syntax (gt/lt/le/...,
# not symbolic operators -- confirmed from existing corpus examples
# before guessing). vsel=gt(A,2) on A=(1,2,3,4,5) correctly keeps
# rows 3,4,5; break=gt(A,3) correctly stops after reading row 4 (A=4
# triggers the break) and keeps only rows 1-3. Both checked by hand.
#
# Found, not chased: tst_break (t_gdat.c) has zero callers anywhere
# in the sources -- break= is evidently implemented through a
# different, simpler inline path. Dead code, same class as
# bfa_lm2/ivreg_h1 elsewhere in this project.

silent = -1;

nvar(dfile=vseldat.dat,
    A=c1, B=c2,
    vsel = gt(A,2),
);
dstat;
