# matc4.cf -- t_matc.c coverage batch 4: mnvar (bootstraps a data
# matrix from a matrix, so it must be the FIRST data command in the
# session), mnrow/mncol/mnorm/mnorm1/mnorm2/mtrace, msrow (using real
# selection syntax <...> to also exercise the shared
# sel_expr/m_selidx/get_mselect helpers)/mscol, mcath/mcatv/mdcathv,
# mnc. Values checked against a python/numpy replica of each
# algorithm.

mdef(A,3,3) =   4.0, 1.0, 0.5,
                1.0, 3.0, 0.2,
                0.5, 0.2, 2.0;

mnvar(A);
dstat;

mnrow(A,NR);
mpr(NR);

mncol(A,NC);
mpr(NC);

mnorm(A,NM);
mpr(NM);

mnorm1(A,NM1);
mpr(NM1);

mnorm2(A,NM2);
mpr(NM2);

mtrace(A,TR);
mpr(TR);

msrow(A,<1,,3>,SR);
mpr(SR);

mdef(CIDX,2,1) = 2, 1;
mscol(A,CIDX,SC);
mpr(SC);

mdef(B,3,2) =   1, 2,
                3, 4,
                5, 6;
mcath(A,B,CH);
mpr(CH);

mdef(C,1,3) = 7, 8, 9;
mcatv(A,C,CV);
mpr(CV);

mdef(D,2,2) = 1, 2, 3, 4;
mcathv(A,D,DS);
mpr(DS);

mnc(A,1,1,NC1);
mpr(NC1);

mnc(A,1,5,NC5);
mpr(NC5);
