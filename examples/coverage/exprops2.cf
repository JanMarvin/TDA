# exprops2.cf -- expression evaluator: dates, counts, distributions, smoothing
nvar(
    dfile = ex.dat,
    ID [2.0] = c1,
    X  [6.2] = c2,
    G  [2.0] = c3,
    F1 [8.4] = jul(1,1,2000),
    F2 [8.4] = juld(jul(1,1,2000)),
    F3 [8.4] = julm(jul(1,1,2000)),
    F4 [8.4] = july(jul(1,1,2000)),
    H1 [8.4] = cnteq(G,1),
    H2 [8.4] = cntne(G,1),
    H3 [8.4] = cntlt(X,3),
    H4 [8.4] = cntle(X,3),
    H5 [8.4] = cntgt(X,3),
    H6 [8.4] = cntge(X,3),
    I1 [8.4] = ndv(G),
    I2 [8.4] = ndv1(G,1),
    I3 [8.4] = ndv2(G,1,2),
    I4 [8.4] = quant(X,0.5),
    I5 [8.4] = poisson(2.0,1),
    I6 [8.4] = negbin(1.0,2.0,1),
    I7 [8.4] = bivn(0.5,0.5,0.2),
    J1 [8.4] = noc,
    J2 [8.4] = nvar,
    J4 [8.4] = num(X,2),
    K1 [8.4] = min(X,3),
    K2 [8.4] = max(X,3),
    K3 [8.4] = ID % 2,
);
pdata() = out.txt;
