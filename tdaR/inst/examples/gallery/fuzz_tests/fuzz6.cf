# Fuzz test 6: duplicate edges between same node pair, node at origin,
# negative curvature both directions, many labels stacked
psfile = fuzz6.ps;
psetup(
    pxa = -10,10,
    pya = -10,10,
    pxlen = 90,
    pylen = 90,
);
plframe;
plg(
    node(n=1,gs=0.5) = 0,0,
    node(n=2,gs=0.5) = 5,5,
    node(n=3,gs=0.5) = -5,-5,

    edge(a=1,1) = 1,2,
    edge(rd=2,a=1,1) = 1,2,
    edge(rd=-2,a=1,1) = 1,2,
    edge(rd=4,a=1,1) = 1,2,
    edge(a=1,1,lt=5) = 1,3,
    edge(a=1,1,lt=9) = 3,1,
);
