# Fuzz test 2: graph edge cases
psfile = fuzz2.ps;
psetup(
    pxa = 0,10,
    pya = 0,10,
    pxlen = 90,
    pylen = 90,
);
plframe;
plg(
    node(n=1,gs=0.8) = 5,5,
    node(n=2,gs=0.8) = 5,5,
    node(n=3,gs=1.0) = 8,8,
    node(n=4,gs=0.0) = 2,2,

    edge(a=1.5,1.0) = 1,2,
    edge(rd=50,a=1.5,1.0,ic=99) = 1,3,
    edge(rd=-50,a=1.5,1.0) = 3,1,
    edge(a=3,3) = 4,4,
    edge(lt=9) = 1,4,
);
