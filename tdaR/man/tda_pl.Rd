p2 <- tda_pl_smooth(p2, "x", "y", ns = 4, lty = "dashed")  # a smoothed fit
p2 <- tda_pl_circle(p2, at = c(3, 5), r = 0.3)    # mark a location
p2 <- tda_pl_text(p2, "peak", at = c(4.3, 9))     # a text label
